generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}

model Driver {
  id                  String    @id @default(cuid())
  name                String
  givenName           String    @default("")
  surname             String    @default("")
  dateOfBirth         String    @default("")
  phone               String
  email               String    @default("")
  address             String    @default("")
  licenceNumber       String    @default("")
  licenceExpiry       String    @default("")
  licenceState        String    @default("QLD")
  uberDriverId        String    @default("")
  abn                 String    @default("")
  emergencyName       String    @default("")
  emergencyPhone      String    @default("")
  emergencyRelation   String    @default("")
  bondAmount          Decimal   @default(0)
  bondPaid            Boolean   @default(false)
  bondPaidDate        String    @default("")
  bondReceiptNumber   String    @default("")
  currentRego         String
  weeklyRent          Decimal
  assignmentStartDate String    @default("")
  isActive            Boolean   @default(true)
  paymentStatus       String    @default("pending")
  lastPaymentDate     DateTime?
  lastPaymentAmount   Decimal?
  amountOwed          Decimal   @default(0)
  notes               String?
  startDate           DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payments            Payment[]
  reminders           Reminder[]
}

model Car {
  id               String    @id @default(cuid())
  rego             String    @unique
  make             String
  model            String
  year             Int
  colour           String
  regoExpiry       DateTime
  bhslExpiry       DateTime?
  bhslNumber       String?
  ctpClass         Int       @default(4)
  weeklyRent       Decimal
  assignedDriverId String?
  batch            Int?
  isPersonal       Boolean   @default(false)
  purchasePrice    Decimal?
  regoStatus       String    @default("ok")
  bhslStatus       String    @default("ok")
  createdAt        DateTime  @default(now())
}

model Payment {
  id             String    @id @default(cuid())
  driverId       String
  rego           String
  amount         Decimal
  expectedAmount Decimal
  dueDate        DateTime
  paidDate       DateTime?
  weekNumber     Int
  year           Int
  status         String    @default("pending")
  notes          String?
  createdAt      DateTime  @default(now())

  driver         Driver    @relation(fields: [driverId], references: [id])
}

model BankTransaction {
  id               String   @id @default(cuid())
  uploadBatchId    String
  date             DateTime
  description      String
  reference        String?
  amount           Decimal
  balance          Decimal?
  matchStatus      String   @default("unmatched")
  matchedDriverId  String?
  matchedDriverName String?
  isManualOverride Boolean  @default(false)
  paymentMethod    String   @default("unknown")
  createdAt        DateTime @default(now())

  uploadBatch      UploadBatch @relation(fields: [uploadBatchId], references: [id])
}

model UploadBatch {
  id             String   @id @default(cuid())
  filename       String
  uploadedAt     DateTime @default(now())
  rowCount       Int
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  matchedCount   Int      @default(0)
  unmatchedCount Int      @default(0)
  totalCredits   Decimal  @default(0)

  transactions   BankTransaction[]
}

model Reminder {
  id          String   @id @default(cuid())
  driverId    String
  type        String
  messageBody String
  status      String   @default("pending")
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  driver      Driver   @relation(fields: [driverId], references: [id])
}